# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Google AI API Key for server-side operations
GOOGLE_API_KEY=your_google_api_key_here

# Google AI API Key for client-side operations (TTS)
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# Gemini API Key (alias for GOOGLE_API_KEY)
GEMINI_API_KEY=your_google_api_key_here

# ⚠️ SECURITY NOTE:
# - Never commit actual API keys to version control
# - Use .env.local for development (automatically ignored by git)
# - Configure environment variables in Vercel dashboard for production
# - Keep API keys secure and rotate them regularly

# ---- Accounts: mobile number + 4-digit PIN ----
# Required for sign-up and sign-in. A Neon (or any Postgres) connection
# string. The auth_users table is created on first use; there is no migrate
# step to run. Free tier is enough: one small table.
DATABASE_URL=

# Required. Any long random string. The session cookie is signed with a key
# derived from it, so changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- The single owner's PIN, from before accounts existed ----
# Optional now. Kept so an existing deployment is not locked out by the deploy
# that introduces accounts: with no DATABASE_URL set, a PIN-only sign-in still
# works against this. New people sign up with a mobile number instead.
# ---- Sign-in (4-digit PIN, server-checked) ----
# Required. The scrypt hash of the owner's PIN as "salt:hash". Make it with:
#   node scripts/pin-hash.mjs 4827
# Without it, sign-in stays closed. Changing it signs out every device.
APP_PIN_HASH=

# Optional but recommended on Vercel: an Upstash Redis REST endpoint, so the
# 5-tries-then-15-minute lock is shared by every server instance. Without it
# the count is kept per server process. The Vercel KV names also work
# (KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
